;; Social Media Integration Rewards Contract\n;; Enables users to earn rewards for social media engagement and platform promotion\n\n;; Contract constants\n(define-constant CONTRACT_OWNER tx-sender)\n(define-constant ERR_NOT_AUTHORIZED (err u700))\n(define-constant ERR_ACCOUNT_ALREADY_LINKED (err u701))\n(define-constant ERR_INVALID_PLATFORM (err u702))\n(define-constant ERR_ACTION_ALREADY_CLAIMED (err u703))\n(define-constant ERR_VERIFICATION_FAILED (err u704))\n(define-constant ERR_INSUFFICIENT_FOLLOWERS (err u705))\n(define-constant ERR_COOLDOWN_ACTIVE (err u706))\n(define-constant ERR_ACCOUNT_NOT_VERIFIED (err u707))\n\n;; Social media platform constants\n(define-constant PLATFORM_TWITTER u1)\n(define-constant PLATFORM_DISCORD u2)\n(define-constant PLATFORM_TELEGRAM u3)\n(define-constant PLATFORM_REDDIT u4)\n\n;; Action type constants\n(define-constant ACTION_TWEET u1)\n(define-constant ACTION_RETWEET u2)\n(define-constant ACTION_LIKE u3)\n(define-constant ACTION_SHARE u4)\n(define-constant ACTION_MENTION u5)\n(define-constant ACTION_JOIN_COMMUNITY u6)\n\n;; Reward amounts by action type\n(define-constant TWEET_REWARD u15)\n(define-constant RETWEET_REWARD u8)\n(define-constant LIKE_REWARD u3)\n(define-constant SHARE_REWARD u12)\n(define-constant MENTION_REWARD u20)\n(define-constant COMMUNITY_JOIN_REWARD u25)\n\n;; Influence tier thresholds and multipliers\n(define-constant MICRO_INFLUENCER_THRESHOLD u1000)\n(define-constant MACRO_INFLUENCER_THRESHOLD u10000)\n(define-constant MEGA_INFLUENCER_THRESHOLD u100000)\n(define-constant MICRO_MULTIPLIER u150)\n(define-constant MACRO_MULTIPLIER u200)\n(define-constant MEGA_MULTIPLIER u300)\n\n;; Cooldown periods (in blocks)\n(define-constant TWEET_COOLDOWN u6)    ;; ~1 hour\n(define-constant RETWEET_COOLDOWN u3)  ;; ~30 min\n(define-constant LIKE_COOLDOWN u1)     ;; ~10 min\n(define-constant SHARE_COOLDOWN u12)   ;; ~2 hours\n\n;; Data variables\n(define-data-var verification-required bool true)\n(define-data-var max-actions-per-day uint u10)\n(define-data-var social-rewards-active bool true)\n\n;; Social media account linking\n(define-map user-social-accounts \n    { user: principal, platform: uint }\n    { handle: (string-ascii 50),\n      follower-count: uint,\n      verified: bool,\n      verification-height: uint,\n      influence-tier: uint })\n\n;; Social media action tracking\n(define-map social-actions\n    { user: principal, action-id: uint }\n    { platform: uint,\n      action-type: uint,\n      action-hash: (string-ascii 100),\n      reward-amount: uint,\n      claimed: bool,\n      timestamp: uint,\n      verification-score: uint })\n\n;; User social activity summary\n(define-map user-social-stats principal\n    { total-actions: uint,\n      total-social-rewards: uint,\n      influence-score: uint,\n      last-action-height: uint,\n      daily-action-count: uint,\n      last-daily-reset: uint })\n\n;; Action cooldowns tracking\n(define-map action-cooldowns\n    { user: principal, action-type: uint }\n    uint)\n\n;; Global social media metrics\n(define-data-var total-social-actions uint u0)\n(define-data-var action-counter uint u0)\n\n;; Link social media account\n(define-public (link-social-account (platform uint) (handle (string-ascii 50)) (follower-count uint))\n    (begin\n        (asserts! (<= platform PLATFORM_REDDIT) ERR_INVALID_PLATFORM)\n        (asserts! (is-none (map-get? user-social-accounts { user: tx-sender, platform: platform })) \n                  ERR_ACCOUNT_ALREADY_LINKED)\n        \n        (map-set user-social-accounts { user: tx-sender, platform: platform }\n            { handle: handle,\n              follower-count: follower-count,\n              verified: false,\n              verification-height: u0,\n              influence-tier: (calculate-influence-tier follower-count) })\n        (ok true)))\n\n;; Verify social media account (admin only)\n(define-public (verify-social-account (user principal) (platform uint))\n    (let ((account-data (unwrap! (map-get? user-social-accounts { user: user, platform: platform })\n                                 ERR_ACCOUNT_NOT_VERIFIED)))\n        (asserts! (is-eq tx-sender CONTRACT_OWNER) ERR_NOT_AUTHORIZED)\n        \n        (map-set user-social-accounts { user: user, platform: platform }\n            (merge account-data \n                { verified: true, verification-height: stacks-block-height }))\n        (ok true)))\n\n;; Record social media action\n(define-public (record-social-action \n    (platform uint) \n    (action-type uint) \n    (action-hash (string-ascii 100)))\n    (let (\n        (account-data (unwrap! (map-get? user-social-accounts { user: tx-sender, platform: platform })\n                              ERR_ACCOUNT_NOT_VERIFIED))\n        (user-stats (default-to \n            { total-actions: u0, total-social-rewards: u0, influence-score: u0,\n              last-action-height: u0, daily-action-count: u0, last-daily-reset: u0 }\n            (map-get? user-social-stats tx-sender)))\n        (last-action (default-to u0 (map-get? action-cooldowns { user: tx-sender, action-type: action-type })))\n        (cooldown-period (get-cooldown-for-action action-type))\n        (base-reward (get-base-reward-for-action action-type))\n        (influence-multiplier (get-influence-multiplier (get influence-tier account-data)))\n        (final-reward (/ (* base-reward influence-multiplier) u100))\n        (action-id (var-get action-counter))\n    )\n        (asserts! (var-get social-rewards-active) ERR_NOT_AUTHORIZED)\n        (asserts! (get verified account-data) ERR_ACCOUNT_NOT_VERIFIED)\n        (asserts! (>= stacks-block-height (+ last-action cooldown-period)) ERR_COOLDOWN_ACTIVE)\n        \n        ;; Reset daily counter if needed\n        (let ((reset-daily-count (should-reset-daily-count user-stats)))\n            \n            ;; Record the action\n            (map-set social-actions { user: tx-sender, action-id: action-id }\n                { platform: platform,\n                  action-type: action-type,\n                  action-hash: action-hash,\n                  reward-amount: final-reward,\n                  claimed: false,\n                  timestamp: stacks-block-height,\n                  verification-score: (get follower-count account-data) })\n            \n            ;; Update cooldowns\n            (map-set action-cooldowns { user: tx-sender, action-type: action-type } \n                     stacks-block-height)\n            \n            ;; Update user stats\n            (map-set user-social-stats tx-sender\n                { total-actions: (+ (get total-actions user-stats) u1),\n                  total-social-rewards: (+ (get total-social-rewards user-stats) final-reward),\n                  influence-score: (calculate-influence-score tx-sender),\n                  last-action-height: stacks-block-height,\n                  daily-action-count: (if reset-daily-count u1 \n                                         (+ (get daily-action-count user-stats) u1)),\n                  last-daily-reset: (if reset-daily-count stacks-block-height \n                                       (get last-daily-reset user-stats)) })\n            \n            ;; Update global counters\n            (var-set action-counter (+ action-id u1))\n            (var-set total-social-actions (+ (var-get total-social-actions) u1))\n            \n            (ok action-id))))\n\n;; Claim social media action reward\n(define-public (claim-social-reward (action-id uint))\n    (let ((action-data (unwrap! (map-get? social-actions { user: tx-sender, action-id: action-id })\n                               ERR_ACTION_ALREADY_CLAIMED)))\n        (asserts! (not (get claimed action-data)) ERR_ACTION_ALREADY_CLAIMED)\n        \n        ;; Transfer reward\n        (try! (as-contract (stx-transfer? (get reward-amount action-data) CONTRACT_OWNER tx-sender)))\n        \n        ;; Mark as claimed\n        (map-set social-actions { user: tx-sender, action-id: action-id }\n            (merge action-data { claimed: true }))\n        \n        (ok (get reward-amount action-data))))\n\n;; Batch verify multiple social actions (admin)\n(define-public (batch-verify-actions (actions (list 10 { user: principal, action-id: uint })))\n    (begin\n        (asserts! (is-eq tx-sender CONTRACT_OWNER) ERR_NOT_AUTHORIZED)\n        (fold verify-single-action actions (ok u0))))\n\n;; Helper functions\n(define-private (calculate-influence-tier (follower-count uint))\n    (if (>= follower-count MEGA_INFLUENCER_THRESHOLD) u4\n    (if (>= follower-count MACRO_INFLUENCER_THRESHOLD) u3\n    (if (>= follower-count MICRO_INFLUENCER_THRESHOLD) u2\n        u1))))\n\n(define-private (get-cooldown-for-action (action-type uint))\n    (if (is-eq action-type ACTION_TWEET) TWEET_COOLDOWN\n    (if (is-eq action-type ACTION_RETWEET) RETWEET_COOLDOWN\n    (if (is-eq action-type ACTION_LIKE) LIKE_COOLDOWN\n        SHARE_COOLDOWN))))\n\n(define-private (get-base-reward-for-action (action-type uint))\n    (if (is-eq action-type ACTION_TWEET) TWEET_REWARD\n    (if (is-eq action-type ACTION_RETWEET) RETWEET_REWARD\n    (if (is-eq action-type ACTION_LIKE) LIKE_REWARD\n    (if (is-eq action-type ACTION_SHARE) SHARE_REWARD\n    (if (is-eq action-type ACTION_MENTION) MENTION_REWARD\n        COMMUNITY_JOIN_REWARD))))))\n\n(define-private (get-influence-multiplier (tier uint))\n    (if (is-eq tier u4) MEGA_MULTIPLIER\n    (if (is-eq tier u3) MACRO_MULTIPLIER\n    (if (is-eq tier u2) MICRO_MULTIPLIER\n        u100))))\n\n(define-private (should-reset-daily-count (user-stats { total-actions: uint, total-social-rewards: uint, influence-score: uint, last-action-height: uint, daily-action-count: uint, last-daily-reset: uint }))\n    (>= (- stacks-block-height (get last-daily-reset user-stats)) u144))\n\n(define-private (calculate-influence-score (user principal))\n    (fold calculate-platform-influence (list u1 u2 u3 u4) u0))\n\n(define-private (calculate-platform-influence (platform uint) (acc-score uint))\n    (let ((account-data (map-get? user-social-accounts { user: tx-sender, platform: platform })))\n        (if (is-some account-data)\n            (let ((account (unwrap-panic account-data)))\n                (if (get verified account)\n                    (+ acc-score (* (get follower-count account) (get influence-tier account)))\n                    acc-score))\n            acc-score)))\n\n(define-private (verify-single-action \n    (action { user: principal, action-id: uint })\n    (previous-result (response uint uint)))\n    (let ((action-data (map-get? social-actions { user: (get user action), action-id: (get action-id action) })))\n        (if (is-some action-data)\n            (ok (+ (unwrap-panic previous-result) u1))\n            previous-result)))\n\n;; Read-only functions\n(define-read-only (get-user-social-account (user principal) (platform uint))\n    (map-get? user-social-accounts { user: user, platform: platform }))\n\n(define-read-only (get-social-action (user principal) (action-id uint))\n    (map-get? social-actions { user: user, action-id: action-id }))\n\n(define-read-only (get-user-social-stats (user principal))\n    (map-get? user-social-stats user))\n\n(define-read-only (get-action-cooldown (user principal) (action-type uint))\n    (default-to u0 (map-get? action-cooldowns { user: user, action-type: action-type })))\n\n(define-read-only (get-system-social-stats)\n    { total-actions: (var-get total-social-actions),\n      verification-required: (var-get verification-required),\n      max-daily-actions: (var-get max-actions-per-day),\n      rewards-active: (var-get social-rewards-active) })\n\n(define-read-only (calculate-potential-reward (user principal) (platform uint) (action-type uint))\n    (let ((account-data (map-get? user-social-accounts { user: user, platform: platform })))\n        (if (is-some account-data)\n            (let ((account (unwrap-panic account-data)))\n                (if (get verified account)\n                    (/ (* (get-base-reward-for-action action-type) \n                         (get-influence-multiplier (get influence-tier account))) u100)\n                    u0))\n            u0)))\n\n;; Admin functions\n(define-public (update-follower-count (user principal) (platform uint) (new-count uint))\n    (let ((account-data (unwrap! (map-get? user-social-accounts { user: user, platform: platform })\n                                ERR_ACCOUNT_NOT_VERIFIED)))\n        (asserts! (is-eq tx-sender CONTRACT_OWNER) ERR_NOT_AUTHORIZED)\n        \n        (map-set user-social-accounts { user: user, platform: platform }\n            (merge account-data \n                { follower-count: new-count,\n                  influence-tier: (calculate-influence-tier new-count) }))\n        (ok true)))\n\n(define-public (toggle-social-rewards)\n    (begin\n        (asserts! (is-eq tx-sender CONTRACT_OWNER) ERR_NOT_AUTHORIZED)\n        (var-set social-rewards-active (not (var-get social-rewards-active)))\n        (ok (var-get social-rewards-active))))\n\n(define-public (set-verification-requirements (required bool))\n    (begin\n        (asserts! (is-eq tx-sender CONTRACT_OWNER) ERR_NOT_AUTHORIZED)\n        (var-set verification-required required)\n        (ok true)))\n\n(define-public (set-daily-action-limit (limit uint))\n    (begin\n        (asserts! (is-eq tx-sender CONTRACT_OWNER) ERR_NOT_AUTHORIZED)\n        (var-set max-actions-per-day limit)\n        (ok true)))\n